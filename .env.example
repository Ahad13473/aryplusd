# Environment file for ARYPlusD (aryplusd.com).
# Copy to .env in the project root, then run: bun run db:push
DATABASE_URL="file:../db/custom.db"

# Public site address used in canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL="https://aryplusd.com"
NEXT_PUBLIC_CONTACT_EMAIL="contact@aryplusd.com"

# Search engine verification codes (Search Console / Bing Webmaster Tools) - optional.
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# Google AdSense - leave empty until approved. Ads and ads.txt switch on automatically once set.
NEXT_PUBLIC_ADSENSE_CLIENT=""          # e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""       # display ad unit id for the home page
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=""    # display ad unit id for guide/legal pages

# Admin panel (/admin): statistics and blog editor. Leave empty to disable.
ADMIN_PASSWORD=""          # at least 8 characters
